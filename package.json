{
  "name": "last-exit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "npm@12.0.2",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local server/index.js --dev-tools=all",
    "dev:lan": "node --env-file-if-exists=.env.local server/index.js --lan --dev-tools=all",
    "test": "node --test tests/*.test.js",
    "test:all": "node --test tests/*.test.js tests/slow/*.test.js",
    "check": "node tests/check.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p map/tools",
    "test:times": "node tests/timing.mjs",
    "bench": "node tests/bench.mjs",
    "bench:client": "node tests/bench-client.mjs",
    "demo": "node tests/demo.mjs",
    "test:browser": "node tests/browser.mjs && node tests/dev-view.browser.mjs && node map/tools/tests/lab.browser.mts",
    "test:micro": "node --test tests/micro-*.test.js && node tests/micro-lab.mjs && node tests/decomposition-lab.mjs && node tests/generation-demo.mjs",
    "test:mapgen": "npm --prefix map/macro test",
    "micro": "node tools/micro-region.mjs",
    "decompose": "node tools/decompose-region.mjs",
    "forgejo:usage": "node tools/forgejo-usage.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide": "^0.468.0",
    "pathfinding": "^0.4.18",
    "phaser": "^3.90.0",
    "sat": "^0.9.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.20.2",
    "typescript": "^7.0.2"
  }
}
